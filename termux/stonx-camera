#!/data/data/com.termux/files/usr/bin/bash
set -u

readonly STONX_VERSION="0.5.1-transfer2"
readonly STONX_APP_ID="com.stonx.camera.bridge"
readonly STONX_ACTIVITY="$STONX_APP_ID/.CaptureActivity"

readonly STONX_BASE="$HOME/STONX-Camera-Bridge"
readonly STONX_PHOTOS="$STONX_BASE/photos"
readonly STONX_VIDEOS="$STONX_BASE/videos"
readonly STONX_AUDIO="$STONX_BASE/audio"
readonly STONX_LOGS="$STONX_BASE/logs"
readonly STONX_TMP="$STONX_BASE/tmp"
readonly STONX_LOG_FILE="$STONX_LOGS/stonx-camera.log"
readonly STONX_PULLED_LOG="$STONX_LOGS/pulled.tsv"
readonly STONX_COPIED_LOG="$STONX_LOGS/copied.tsv"

readonly STONX_SHARED_ROOT="/sdcard/Download/STONX-Camera-Bridge"
readonly STONX_SHARED_INBOX="$STONX_SHARED_ROOT/inbox"
readonly STONX_SHARED_OUT="$STONX_SHARED_ROOT/out"
readonly STONX_SHARED_PHOTOS="/sdcard/Pictures/STONX-Camera-Bridge"
readonly STONX_SHARED_VIDEOS="/sdcard/Movies/STONX-Camera-Bridge"
readonly STONX_SHARED_AUDIO="/sdcard/Music/STONX-Camera-Bridge"

readonly STONX_OK=0
readonly STONX_USAGE=2
readonly STONX_DEP=3
readonly STONX_HELPER=4
readonly STONX_FAILED=5
readonly STONX_STORAGE=6
readonly STONX_NOT_ENABLED=9
readonly STONX_LOW_BRIGHTNESS=35

usage() {
  cat <<'EOF'
STONX Camera Bridge

Usage:
  stonx-camera --install
  stonx-camera permission
  stonx-camera status
  stonx-camera photo back|front
  stonx-camera video back|front <seconds>
  stonx-camera audio <seconds>
  stonx-camera list
  stonx-camera pull
  stonx-camera clean
EOF
}

log_line() {
  mkdir -p "$STONX_LOGS" 2>/dev/null || return 0
  printf '%s\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$STONX_LOG_FILE" 2>/dev/null || true
}

ensure_dirs() {
  mkdir -p "$STONX_PHOTOS" "$STONX_VIDEOS" "$STONX_AUDIO" "$STONX_LOGS" "$STONX_TMP" || return 1
  touch "$STONX_PULLED_LOG" "$STONX_COPIED_LOG" 2>/dev/null || true
}

err() {
  printf 'stonx-camera: error: %s\n' "$*" >&2
  log_line "ERROR $*"
}

die() {
  err "$1"
  exit "${2:-$STONX_USAGE}"
}

require_no_args() {
  if [[ $# -ne 0 ]]; then
    err "unexpected argument(s): $*"
    usage >&2
    exit "$STONX_USAGE"
  fi
}

valid_face() {
  [[ "${1:-}" == "back" || "${1:-}" == "front" ]]
}

valid_duration() {
  local d="${1:-}"
  [[ "$d" =~ ^[0-9]+$ ]] || return 1
  (( d > 0 && d <= 3600 )) || return 1
}

new_request_id() {
  printf '%s-%s-%s' "$(date '+%Y%m%d-%H%M%S')" "$$" "$RANDOM"
}

json_ok() {
  grep -q '"ok":true' "$1" 2>/dev/null
}

json_get_string() {
  local file="$1"
  local key="$2"
  sed -n 's/.*"'"$key"'":"\([^"]*\)".*/\1/p' "$file" 2>/dev/null | head -n 1
}

json_get_long() {
  local file="$1"
  local key="$2"
  sed -n 's/.*"'"$key"'":\([0-9][0-9]*\).*/\1/p' "$file" 2>/dev/null | head -n 1
}

json_get_bool() {
  local file="$1"
  local key="$2"
  if grep -q '"'"$key"'":true' "$file" 2>/dev/null; then
    printf 'true'
  else
    printf 'false'
  fi
}

file_size() {
  stat -c %s "$1" 2>/dev/null
}

file_created() {
  local c
  c="$(stat -c %w "$1" 2>/dev/null || true)"
  if [[ -z "$c" || "$c" == "-" ]]; then
    c="$(stat -c %y "$1" 2>/dev/null || true)"
  fi
  printf '%s' "${c:-unknown}"
}

sha256_of() {
  sha256sum "$1" 2>/dev/null | awk '{print $1}'
}

media_kind_for_path() {
  local p="$1"
  case "$p" in
    "$STONX_SHARED_PHOTOS"/*.jpg) printf 'photo' ;;
    "$STONX_SHARED_VIDEOS"/*.mp4) printf 'video' ;;
    "$STONX_SHARED_AUDIO"/*.m4a) printf 'audio' ;;
    *) printf '' ;;
  esac
}

dest_dir_for_kind() {
  case "$1" in
    photo) printf '%s' "$STONX_PHOTOS" ;;
    video) printf '%s' "$STONX_VIDEOS" ;;
    audio) printf '%s' "$STONX_AUDIO" ;;
    *) printf '' ;;
  esac
}

is_marked_pulled() {
  local path="$1"
  [[ -f "$STONX_PULLED_LOG" ]] || return 1
  awk -F '\t' -v p="$path" '$1 == p { found=1 } END { exit(found ? 0 : 1) }' "$STONX_PULLED_LOG" 2>/dev/null
}

record_pulled() {
  local shared_path="$1"
  local kind="$2"
  local dest="$3"
  local size="$4"
  local sha256="$5"
  printf '%s\t%s\t%s\t%s\t%s\ttrue\t%s\n' \
    "$shared_path" "$kind" "$dest" "$size" "$sha256" "$(date '+%Y-%m-%d %H:%M:%S')" >> "$STONX_PULLED_LOG" 2>/dev/null || true
}

is_marked_copied() {
  local path="$1"
  [[ -f "$STONX_COPIED_LOG" ]] || return 1
  grep -Fxq -- "$path" "$STONX_COPIED_LOG" 2>/dev/null
}

record_copied() {
  local path="$1"
  if ! is_marked_copied "$path"; then
    printf '%s\n' "$path" >> "$STONX_COPIED_LOG" 2>/dev/null || true
  fi
}

unmark_copied() {
  local path="$1"
  [[ -f "$STONX_COPIED_LOG" ]] || return 0
  grep -Fxv -- "$path" "$STONX_COPIED_LOG" > "$STONX_COPIED_LOG.tmp" 2>/dev/null || true
  mv -f -- "$STONX_COPIED_LOG.tmp" "$STONX_COPIED_LOG" 2>/dev/null || true
}

verify_copy_matches() {
  local src="$1"
  local dst="$2"
  local src_size
  local dst_size
  local src_sha
  local dst_sha

  src_size="$(file_size "$src")"
  dst_size="$(file_size "$dst")"
  if [[ -z "$src_size" || -z "$dst_size" || "$src_size" != "$dst_size" || "$src_size" -le 0 ]]; then
    return 1
  fi
  src_sha="$(sha256_of "$src")"
  dst_sha="$(sha256_of "$dst")"
  [[ -n "$src_sha" && -n "$dst_sha" && "$src_sha" == "$dst_sha" ]]
}

verify_photo_status() {
  local file="$1"
  local actual_size
  local actual_sha256
  local header

  VERIFIED_PATH="$(json_get_string "$file" path)"
  VERIFIED_SIZE="$(json_get_long "$file" size)"
  VERIFIED_SHA256="$(json_get_string "$file" sha256)"

  if [[ -z "$VERIFIED_PATH" || -z "$VERIFIED_SIZE" || -z "$VERIFIED_SHA256" ]]; then
    err "photo verification failed: missing path/size/sha256 in status JSON"
    return 1
  fi
  if [[ ! -f "$VERIFIED_PATH" ]]; then
    err "photo verification failed: file not found: $VERIFIED_PATH"
    return 1
  fi
  actual_size="$(file_size "$VERIFIED_PATH")"
  if [[ -z "$actual_size" || "$actual_size" != "$VERIFIED_SIZE" || "$actual_size" -le 0 ]]; then
    err "photo verification failed: bad size (status=$VERIFIED_SIZE actual=${actual_size:-unknown})"
    return 1
  fi
  header="$(od -An -N2 -tx1 "$VERIFIED_PATH" 2>/dev/null | tr -d ' \n')"
  if [[ "$header" != "ffd8" ]]; then
    err "photo verification failed: not a JPEG (header=${header:-unknown})"
    return 1
  fi
  actual_sha256="$(sha256_of "$VERIFIED_PATH")"
  if [[ -z "$actual_sha256" || "$actual_sha256" != "$VERIFIED_SHA256" ]]; then
    err "photo verification failed: sha256 mismatch"
    return 1
  fi
  return 0
}

verify_audio_status() {
  local file="$1"
  local expected_ms="$2"
  local actual_size
  local actual_sha256
  local header
  local diff
  local allowed

  VERIFIED_PATH="$(json_get_string "$file" path)"
  VERIFIED_SIZE="$(json_get_long "$file" size)"
  VERIFIED_SHA256="$(json_get_string "$file" sha256)"
  AUDIO_DURATION_MS="$(json_get_long "$file" duration_ms)"
  AUDIO_SIGNAL_LEVEL="$(json_get_long "$file" signal_level)"
  [[ "$AUDIO_DURATION_MS" =~ ^[0-9]+$ ]] || AUDIO_DURATION_MS=-1
  [[ "$AUDIO_SIGNAL_LEVEL" =~ ^-?[0-9]+$ ]] || AUDIO_SIGNAL_LEVEL=-1

  if [[ -z "$VERIFIED_PATH" || -z "$VERIFIED_SIZE" || -z "$VERIFIED_SHA256" ]]; then
    err "audio verification failed: missing path/size/sha256 in status JSON"
    return 1
  fi
  if [[ ! -f "$VERIFIED_PATH" ]]; then
    err "audio verification failed: file not found: $VERIFIED_PATH"
    return 1
  fi
  actual_size="$(file_size "$VERIFIED_PATH")"
  if [[ -z "$actual_size" || "$actual_size" != "$VERIFIED_SIZE" || "$actual_size" -le 0 ]]; then
    err "audio verification failed: bad size (status=$VERIFIED_SIZE actual=${actual_size:-unknown})"
    return 1
  fi
  header="$(od -An -N12 -tx1 "$VERIFIED_PATH" 2>/dev/null | tr -d ' \n')"
  if [[ -z "$header" || "${header:8:8}" != "66747970" ]]; then
    err "audio verification failed: not an MP4/M4A ftyp file"
    return 1
  fi
  actual_sha256="$(sha256_of "$VERIFIED_PATH")"
  if [[ -z "$actual_sha256" || "$actual_sha256" != "$VERIFIED_SHA256" ]]; then
    err "audio verification failed: sha256 mismatch"
    return 1
  fi
  if [[ "$AUDIO_DURATION_MS" -lt 0 ]]; then
    err "audio verification failed: missing actual duration"
    return 1
  fi
  allowed=$(( expected_ms / 5 ))
  (( allowed < 300 )) && allowed=300
  (( allowed > 2000 )) && allowed=2000
  if [[ "$AUDIO_DURATION_MS" -gt "$expected_ms" ]]; then
    diff=$(( AUDIO_DURATION_MS - expected_ms ))
  else
    diff=$(( expected_ms - AUDIO_DURATION_MS ))
  fi
  if [[ "$diff" -gt "$allowed" ]]; then
    err "audio verification failed: duration mismatch (expected=${expected_ms}ms actual=${AUDIO_DURATION_MS}ms allowed=${allowed}ms)"
    return 1
  fi
  return 0
}

verify_video_status() {
  local file="$1"
  local expected_ms="$2"
  local actual_size
  local actual_sha256
  local header
  local diff
  local allowed

  VERIFIED_PATH="$(json_get_string "$file" path)"
  VERIFIED_SIZE="$(json_get_long "$file" size)"
  VERIFIED_SHA256="$(json_get_string "$file" sha256)"
  VIDEO_DURATION_MS="$(json_get_long "$file" duration_ms)"
  VIDEO_WIDTH="$(json_get_long "$file" width)"
  VIDEO_HEIGHT="$(json_get_long "$file" height)"
  VIDEO_BRIGHTNESS="$(json_get_long "$file" brightness)"
  VIDEO_SIGNAL_LEVEL="$(json_get_long "$file" signal_level)"
  VIDEO_HAS_VIDEO="$(json_get_bool "$file" has_video)"
  VIDEO_HAS_AUDIO="$(json_get_bool "$file" has_audio)"

  [[ "$VIDEO_DURATION_MS" =~ ^[0-9]+$ ]] || VIDEO_DURATION_MS=-1
  [[ "$VIDEO_WIDTH" =~ ^[0-9]+$ ]] || VIDEO_WIDTH=-1
  [[ "$VIDEO_HEIGHT" =~ ^[0-9]+$ ]] || VIDEO_HEIGHT=-1
  [[ "$VIDEO_BRIGHTNESS" =~ ^-?[0-9]+$ ]] || VIDEO_BRIGHTNESS=-1
  [[ "$VIDEO_SIGNAL_LEVEL" =~ ^-?[0-9]+$ ]] || VIDEO_SIGNAL_LEVEL=-1

  if [[ -z "$VERIFIED_PATH" || -z "$VERIFIED_SIZE" || -z "$VERIFIED_SHA256" ]]; then
    err "video verification failed: missing path/size/sha256 in status JSON"
    return 1
  fi
  if [[ ! -f "$VERIFIED_PATH" ]]; then
    err "video verification failed: file not found: $VERIFIED_PATH"
    return 1
  fi
  actual_size="$(file_size "$VERIFIED_PATH")"
  if [[ -z "$actual_size" || "$actual_size" != "$VERIFIED_SIZE" || "$actual_size" -le 0 ]]; then
    err "video verification failed: bad size (status=$VERIFIED_SIZE actual=${actual_size:-unknown})"
    return 1
  fi
  header="$(od -An -N12 -tx1 "$VERIFIED_PATH" 2>/dev/null | tr -d ' \n')"
  if [[ -z "$header" || "${header:8:8}" != "66747970" ]]; then
    err "video verification failed: not an MP4/M4A ftyp file"
    return 1
  fi
  actual_sha256="$(sha256_of "$VERIFIED_PATH")"
  if [[ -z "$actual_sha256" || "$actual_sha256" != "$VERIFIED_SHA256" ]]; then
    err "video verification failed: sha256 mismatch"
    return 1
  fi
  if [[ "$VIDEO_HAS_VIDEO" != "true" || "$VIDEO_HAS_AUDIO" != "true" ]]; then
    err "video verification failed: missing video/audio track (has_video=$VIDEO_HAS_VIDEO has_audio=$VIDEO_HAS_AUDIO)"
    return 1
  fi
  if [[ "$VIDEO_WIDTH" -le 0 || "$VIDEO_HEIGHT" -le 0 ]]; then
    err "video verification failed: invalid dimensions ${VIDEO_WIDTH}x${VIDEO_HEIGHT}"
    return 1
  fi
  if [[ "$VIDEO_DURATION_MS" -lt 0 ]]; then
    err "video verification failed: missing actual duration"
    return 1
  fi
  allowed=$(( expected_ms / 5 ))
  (( allowed < 500 )) && allowed=500
  (( allowed > 3000 )) && allowed=3000
  if [[ "$VIDEO_DURATION_MS" -gt "$expected_ms" ]]; then
    diff=$(( VIDEO_DURATION_MS - expected_ms ))
  else
    diff=$(( expected_ms - VIDEO_DURATION_MS ))
  fi
  if [[ "$diff" -gt "$allowed" ]]; then
    err "video verification failed: duration mismatch (expected=${expected_ms}ms actual=${VIDEO_DURATION_MS}ms allowed=${allowed}ms)"
    return 1
  fi
  return 0
}

am_output_has_helper_call_failure() {
  local file="$1"
  grep -Eiq \
    'Error:[[:space:]]+Activity class .*does not exist|Error type 3|Activity not started' \
    "$file" 2>/dev/null
}

first_am_output_line() {
  local file="$1"
  local line
  line="$(grep -Eiv '^[[:space:]]*$' "$file" 2>/dev/null | head -n 1)"
  printf '%s' "${line:-empty-am-output}"
}

run_helper() {
  local type="$1"
  local face="$2"
  local duration="$3"
  local request_id="$4"
  local timeout_secs="${5:-25}"

  local status_inbox="$STONX_SHARED_INBOX"
  local status_file="$status_inbox/$request_id.json"
  local am_out="$STONX_TMP/am-$request_id.log"
  local am_rc
  local reason
  local path
  local deadline

  if ! command -v am >/dev/null 2>&1; then
    err "Termux dependency missing: am"
    return "$STONX_DEP"
  fi
  if ! ensure_dirs; then
    err "cannot create Termux work directories"
    return "$STONX_STORAGE"
  fi

  log_line "RUN request=$request_id type=$type face=$face duration=$duration timeout=$timeout_secs output_dir=$status_inbox"

  : > "$am_out" 2>/dev/null || true
  am start \
      -n "$STONX_ACTIVITY" \
      --es type "$type" \
      --es face "$face" \
      --ei duration_seconds "$duration" \
      --es output_dir "$status_inbox" \
      --es request_id "$request_id" > "$am_out" 2>&1
  am_rc=$?

  if am_output_has_helper_call_failure "$am_out"; then
    if grep -Eiq 'does not exist|Error type 3' "$am_out" 2>/dev/null; then
      err "helper component not installed or APK version does not match this script: $STONX_ACTIVITY"
      printf '%s\n' "stonx-camera: المكوّن غير مثبت أو إصدار الـ APK لا يطابق السكربت" >&2
    else
      err "helper component not callable: $(first_am_output_line "$am_out")"
    fi
    log_line "RUN request=$request_id type=$type result=helper_not_callable component=$STONX_ACTIVITY"
    return "$STONX_HELPER"
  fi

  if (( am_rc != 0 )); then
    err "am start failed (rc=$am_rc): $(first_am_output_line "$am_out")"
    return "$STONX_FAILED"
  fi

  deadline=$((SECONDS + timeout_secs))
  while (( SECONDS < deadline )); do
    if [[ -s "$status_file" ]]; then
      sleep 0.2
      if json_ok "$status_file"; then
        if [[ "$type" == "photo" ]]; then
          if ! verify_photo_status "$status_file"; then
            printf 'RESULT failed request=%s reason=photo_verification_failed\n' "$request_id"
            log_line "RUN request=$request_id type=$type result=failed reason=photo_verification_failed"
            return "$STONX_FAILED"
          fi
          PHOTO_BRIGHTNESS="$(json_get_long "$status_file" brightness)"
          PHOTO_AE_STATE="$(json_get_string "$status_file" ae_state)"
          PHOTO_EXPOSURE_NS="$(json_get_long "$status_file" exposure_ns)"
          PHOTO_ISO="$(json_get_long "$status_file" iso)"
          [[ "$PHOTO_BRIGHTNESS" =~ ^[0-9]+$ ]] || PHOTO_BRIGHTNESS=-1
          printf 'RESULT ok request=%s path=%s size=%s sha256=%s brightness=%s ae_state=%s exposure_ns=%s iso=%s\n' \
            "$request_id" "$VERIFIED_PATH" "$VERIFIED_SIZE" "$VERIFIED_SHA256" \
            "$PHOTO_BRIGHTNESS" "$PHOTO_AE_STATE" "$PHOTO_EXPOSURE_NS" "$PHOTO_ISO"
          if [[ "$PHOTO_BRIGHTNESS" -ge 0 && "$PHOTO_BRIGHTNESS" -lt "$STONX_LOW_BRIGHTNESS" ]]; then
            printf 'WARNING: low_brightness=%s threshold=%s\n' "$PHOTO_BRIGHTNESS" "$STONX_LOW_BRIGHTNESS" >&2
          fi
          log_line "RUN request=$request_id type=$type result=ok path=$VERIFIED_PATH size=$VERIFIED_SIZE sha256=$VERIFIED_SHA256 brightness=$PHOTO_BRIGHTNESS ae_state=$PHOTO_AE_STATE exposure_ns=$PHOTO_EXPOSURE_NS iso=$PHOTO_ISO"
          return "$STONX_OK"
        fi

        if [[ "$type" == "audio" ]]; then
          if ! verify_audio_status "$status_file" "$(( duration * 1000 ))"; then
            printf 'RESULT failed request=%s reason=audio_verification_failed\n' "$request_id"
            log_line "RUN request=$request_id type=$type result=failed reason=audio_verification_failed"
            return "$STONX_FAILED"
          fi
          printf 'RESULT ok request=%s path=%s size=%s sha256=%s duration_ms=%s signal_level=%s\n' \
            "$request_id" "$VERIFIED_PATH" "$VERIFIED_SIZE" "$VERIFIED_SHA256" "$AUDIO_DURATION_MS" "$AUDIO_SIGNAL_LEVEL"
          if [[ "$AUDIO_SIGNAL_LEVEL" -eq 0 ]]; then
            printf 'WARNING: silent_audio signal_level=0\n' >&2
          fi
          log_line "RUN request=$request_id type=$type result=ok path=$VERIFIED_PATH size=$VERIFIED_SIZE sha256=$VERIFIED_SHA256 duration_ms=$AUDIO_DURATION_MS signal_level=$AUDIO_SIGNAL_LEVEL"
          return "$STONX_OK"
        fi

        if [[ "$type" == "video" ]]; then
          if ! verify_video_status "$status_file" "$(( duration * 1000 ))"; then
            printf 'RESULT failed request=%s reason=video_verification_failed\n' "$request_id"
            log_line "RUN request=$request_id type=$type result=failed reason=video_verification_failed"
            return "$STONX_FAILED"
          fi
          printf 'RESULT ok request=%s path=%s size=%s sha256=%s duration_ms=%s width=%s height=%s has_video=%s has_audio=%s brightness=%s signal_level=%s\n' \
            "$request_id" "$VERIFIED_PATH" "$VERIFIED_SIZE" "$VERIFIED_SHA256" \
            "$VIDEO_DURATION_MS" "$VIDEO_WIDTH" "$VIDEO_HEIGHT" "$VIDEO_HAS_VIDEO" "$VIDEO_HAS_AUDIO" \
            "$VIDEO_BRIGHTNESS" "$VIDEO_SIGNAL_LEVEL"
          if [[ "$VIDEO_BRIGHTNESS" -ge 0 && "$VIDEO_BRIGHTNESS" -lt "$STONX_LOW_BRIGHTNESS" ]]; then
            printf 'WARNING: dark_video brightness=%s threshold=%s\n' "$VIDEO_BRIGHTNESS" "$STONX_LOW_BRIGHTNESS" >&2
          fi
          if [[ "$VIDEO_SIGNAL_LEVEL" -eq 0 ]]; then
            printf 'WARNING: silent_audio signal_level=0\n' >&2
          fi
          log_line "RUN request=$request_id type=$type result=ok path=$VERIFIED_PATH size=$VERIFIED_SIZE sha256=$VERIFIED_SHA256 duration_ms=$VIDEO_DURATION_MS width=$VIDEO_WIDTH height=$VIDEO_HEIGHT has_video=$VIDEO_HAS_VIDEO has_audio=$VIDEO_HAS_AUDIO brightness=$VIDEO_BRIGHTNESS signal_level=$VIDEO_SIGNAL_LEVEL"
          return "$STONX_OK"
        fi

        path="$(json_get_string "$status_file" path)"
        printf 'RESULT ok request=%s path=%s\n' "$request_id" "$path"
        log_line "RUN request=$request_id type=$type result=ok path=$path"
        return "$STONX_OK"
      else
        reason="$(json_get_string "$status_file" reason)"
        printf 'RESULT failed request=%s reason=%s\n' "$request_id" "${reason:-unknown}"
        log_line "RUN request=$request_id type=$type result=failed reason=$reason"
        return "$STONX_FAILED"
      fi
    fi
    sleep 0.2
  done

  err "status timeout after ${timeout_secs}s: $status_file"
  log_line "RUN request=$request_id type=$type result=timeout file=$status_file"
  printf 'RESULT failed request=%s reason=status_timeout\n' "$request_id"
  return "$STONX_FAILED"
}

run_delete_helper() {
  local shared_path="$1"
  local request_id="$2"
  local timeout_secs="${3:-30}"

  local status_inbox="$STONX_SHARED_INBOX"
  local status_file="$status_inbox/$request_id.json"
  local am_out="$STONX_TMP/am-$request_id.log"
  local am_rc
  local reason
  local deadline

  if ! command -v am >/dev/null 2>&1; then
    err "Termux dependency missing: am"
    return "$STONX_DEP"
  fi
  if ! ensure_dirs; then
    err "cannot create Termux work directories"
    return "$STONX_STORAGE"
  fi

  log_line "DELETE request=$request_id shared_path=$shared_path timeout=$timeout_secs"

  : > "$am_out" 2>/dev/null || true
  am start \
      -n "$STONX_ACTIVITY" \
      --es type delete_shared \
      --es face back \
      --ei duration_seconds 0 \
      --es shared_path "$shared_path" \
      --es request_id "$request_id" > "$am_out" 2>&1
  am_rc=$?

  if am_output_has_helper_call_failure "$am_out"; then
    err "delete helper component not installed or not callable: $(first_am_output_line "$am_out")"
    return "$STONX_HELPER"
  fi
  if (( am_rc != 0 )); then
    err "delete am start failed (rc=$am_rc): $(first_am_output_line "$am_out")"
    return "$STONX_FAILED"
  fi

  deadline=$((SECONDS + timeout_secs))
  while (( SECONDS < deadline )); do
    if [[ -s "$status_file" ]]; then
      sleep 0.2
      if json_ok "$status_file"; then
        printf 'RESULT ok request=%s path=%s\n' "$request_id" "$shared_path"
        log_line "DELETE request=$request_id result=ok shared_path=$shared_path"
        return "$STONX_OK"
      else
        reason="$(json_get_string "$status_file" reason)"
        printf 'RESULT failed request=%s reason=%s\n' "$request_id" "${reason:-unknown}"
        log_line "DELETE request=$request_id result=failed reason=$reason shared_path=$shared_path"
        return "$STONX_FAILED"
      fi
    fi
    sleep 0.2
  done

  err "delete status timeout after ${timeout_secs}s: $status_file"
  printf 'RESULT failed request=%s reason=delete_status_timeout\n' "$request_id"
  return "$STONX_FAILED"
}

cmd_photo() {
  local face="$1"
  ensure_dirs || die "cannot create $STONX_BASE" "$STONX_STORAGE"
  local request_id
  request_id="$(new_request_id)-photo-$face"
  run_helper photo "$face" 0 "$request_id" 45
}

cmd_audio() {
  local duration="$1"
  ensure_dirs || die "cannot create $STONX_BASE" "$STONX_STORAGE"
  local request_id
  request_id="$(new_request_id)-audio-${duration}s"
  run_helper audio back "$duration" "$request_id" "$(( duration + 20 ))"
}

cmd_video() {
  local face="$1"
  local duration="$2"
  ensure_dirs || die "cannot create $STONX_BASE" "$STONX_STORAGE"
  local request_id
  request_id="$(new_request_id)-video-${face}-${duration}s"
  run_helper video "$face" "$duration" "$request_id" "$(( duration + 25 ))"
}

cmd_status() {
  require_no_args "$@"
  ensure_dirs || die "cannot create $STONX_BASE" "$STONX_STORAGE"
  local request_id
  request_id="$(new_request_id)-status"
  run_helper stage2 back 0 "$request_id" 25
}

cmd_permission() {
  require_no_args "$@"
  ensure_dirs || die "cannot create $STONX_BASE" "$STONX_STORAGE"
  local request_id
  request_id="$(new_request_id)-permission"
  run_helper stage2 back 0 "$request_id" 30
}

cmd_list() {
  require_no_args "$@"
  ensure_dirs || die "cannot create $STONX_BASE" "$STONX_STORAGE"

  local spec
  local kind
  local dir
  local pattern
  local f
  local base
  local maybe_dest
  local size
  local created
  local status

  printf 'STATUS\tTYPE\tSIZE\tCREATED\tPATH\n'

  for spec in \
    "photo|$STONX_SHARED_PHOTOS|*.jpg" \
    "video|$STONX_SHARED_VIDEOS|*.mp4" \
    "audio|$STONX_SHARED_AUDIO|*.m4a"; do
    IFS='|' read -r kind dir pattern <<< "$spec"
    [[ -d "$dir" ]] || continue
    while IFS= read -r -d '' f; do
      [[ -f "$f" ]] || continue
      base="$(basename "$f")"
      [[ "$base" == .* ]] && continue
      maybe_dest="$(dest_dir_for_kind "$kind")/$base"
      size="$(file_size "$f")"
      created="$(file_created "$f")"
      status="pending"
      if is_marked_copied "$f" || { [[ -e "$maybe_dest" ]] && verify_copy_matches "$f" "$maybe_dest"; }; then
        status="copied_not_deleted"
      fi
      printf '%s\t%s\t%s\t%s\t%s\n' "$status" "$kind" "${size:-0}" "$created" "$f"
    done < <(find "$dir" -maxdepth 1 -type f -name "$pattern" -print0 2>/dev/null | sort -z)
  done

  if [[ -f "$STONX_PULLED_LOG" ]]; then
    local shared_path
    local logged_kind
    local dest
    local logged_size
    local logged_sha
    local deleted
    local ts
    while IFS=$'\t' read -r shared_path logged_kind dest logged_size logged_sha deleted ts; do
      [[ "$deleted" == "true" ]] || continue
      [[ -e "$shared_path" ]] && continue
      printf '%s\t%s\t%s\t%s\t%s\n' "done" "${logged_kind:-unknown}" "${logged_size:--}" "${ts:--}" "$shared_path"
    done < "$STONX_PULLED_LOG"
  fi
}

cmd_pull() {
  require_no_args "$@"
  ensure_dirs || die "cannot create $STONX_BASE" "$STONX_STORAGE"

  local processed=0
  local failures=0
  local spec
  local kind
  local dir
  local pattern
  local src
  local base
  local dest_dir
  local dest
  local tmp_dest
  local src_size
  local src_sha
  local request_id

  for spec in \
    "photo|$STONX_SHARED_PHOTOS|*.jpg" \
    "video|$STONX_SHARED_VIDEOS|*.mp4" \
    "audio|$STONX_SHARED_AUDIO|*.m4a"; do
    IFS='|' read -r kind dir pattern <<< "$spec"
    [[ -d "$dir" ]] || continue
    dest_dir="$(dest_dir_for_kind "$kind")"
    [[ -n "$dest_dir" ]] || continue
    mkdir -p "$dest_dir" 2>/dev/null || true

    while IFS= read -r -d '' src; do
      [[ -f "$src" ]] || continue
      base="$(basename "$src")"
      [[ "$base" == .* ]] && continue
      processed=1
      dest="$dest_dir/$base"

      if is_marked_copied "$src" && [[ -e "$dest" ]] && verify_copy_matches "$src" "$dest"; then
        request_id="$(new_request_id)-pull-delete"
        if run_delete_helper "$src" "$request_id" 30 && [[ ! -e "$src" ]]; then
          unmark_copied "$src"
          src_size="$(file_size "$dest")"
          src_sha="$(sha256_of "$dest")"
          record_pulled "$src" "$kind" "$dest" "${src_size:-0}" "${src_sha:-}"
          printf 'PULLED %s -> %s\n' "$src" "$dest"
          log_line "PULL src=$src kind=$kind dest=$dest result=ok_copy_reused_delete_confirmed"
        else
          err "pull delete helper failed or original still exists: $src"
          log_line "PULL src=$src kind=$kind dest=$dest result=delete_retry_failed"
          failures=$(( failures + 1 ))
        fi
        continue
      fi

      tmp_dest="$dest.part-$$-$RANDOM"
      rm -f -- "$tmp_dest" 2>/dev/null || true

      if ! cp -f -- "$src" "$tmp_dest" 2>/dev/null; then
        rm -f -- "$tmp_dest" 2>/dev/null || true
        err "pull copy failed: $src"
        log_line "PULL src=$src kind=$kind result=copy_failed"
        failures=$(( failures + 1 ))
        continue
      fi

      if ! verify_copy_matches "$src" "$tmp_dest"; then
        rm -f -- "$tmp_dest" 2>/dev/null || true
        err "pull verification failed: $src"
        log_line "PULL src=$src kind=$kind result=verify_failed"
        failures=$(( failures + 1 ))
        continue
      fi

      if ! mv -f -- "$tmp_dest" "$dest" 2>/dev/null; then
        rm -f -- "$tmp_dest" 2>/dev/null || true
        err "pull finalize failed: $dest"
        log_line "PULL src=$src kind=$kind dest=$dest result=finalize_failed"
        failures=$(( failures + 1 ))
        continue
      fi

      record_copied "$src"
      request_id="$(new_request_id)-pull-delete"
      if ! run_delete_helper "$src" "$request_id" 30; then
        err "pull delete helper failed for: $src"
        log_line "PULL src=$src kind=$kind dest=$dest result=delete_failed"
        failures=$(( failures + 1 ))
        continue
      fi

      if [[ -e "$src" ]]; then
        err "pull delete reported ok but original still exists: $src"
        log_line "PULL src=$src kind=$kind dest=$dest result=delete_confirmed_but_original_exists"
        failures=$(( failures + 1 ))
        continue
      fi

      unmark_copied "$src"
      src_size="$(file_size "$dest")"
      src_sha="$(sha256_of "$dest")"
      record_pulled "$src" "$kind" "$dest" "${src_size:-0}" "${src_sha:-}"
      printf 'PULLED %s -> %s\n' "$src" "$dest"
      log_line "PULL src=$src kind=$kind dest=$dest size=${src_size:-0} sha256=${src_sha:-} result=ok"
    done < <(find "$dir" -maxdepth 1 -type f -name "$pattern" -print0 2>/dev/null | sort -z)
  done

  if [[ "$processed" -eq 0 ]]; then
    printf 'pull: nothing to do\n'
    return "$STONX_OK"
  fi
  if [[ "$failures" -gt 0 ]]; then
    err "pull completed with failures: $failures"
    return "$STONX_FAILED"
  fi
  return "$STONX_OK"
}

not_enabled() {
  local name="$1"
  printf 'stonx-camera: %s: not enabled yet\n' "$name" >&2
  log_line "NOT_ENABLED command=$name"
  exit "$STONX_NOT_ENABLED"
}

if [[ "${1:-}" == "--install" ]]; then
  if [[ -z "${PREFIX:-}" ]]; then
    die "PREFIX is not set; run this inside Termux" "$STONX_DEP"
  fi
  script_source="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
  mkdir -p "$PREFIX/bin" || die "cannot create $PREFIX/bin" "$STONX_DEP"
  install -m 755 "$script_source" "$PREFIX/bin/stonx-camera" || die "install failed" "$STONX_DEP"
  printf 'installed: %s\n' "$PREFIX/bin/stonx-camera"
  exit "$STONX_OK"
fi

main() {
  local cmd="${1:-}"
  if [[ $# -gt 0 ]]; then
    shift || true
  fi

  case "$cmd" in
    ""|-h|--help|help)
      usage
      exit "$STONX_OK"
      ;;
    status)
      cmd_status "$@"
      ;;
    permission)
      cmd_permission "$@"
      ;;
    photo)
      if [[ $# -ne 1 ]]; then
        err "photo requires: back|front"
        usage >&2
        exit "$STONX_USAGE"
      fi
      valid_face "$1" || die "photo face must be back or front" "$STONX_USAGE"
      cmd_photo "$1"
      ;;
    video)
      if [[ $# -ne 2 ]]; then
        err "video requires: back|front <seconds>"
        usage >&2
        exit "$STONX_USAGE"
      fi
      valid_face "$1" || die "video face must be back or front" "$STONX_USAGE"
      valid_duration "$2" || die "video duration must be an integer 1..3600" "$STONX_USAGE"
      cmd_video "$1" "$2"
      ;;
    audio)
      if [[ $# -ne 1 ]]; then
        err "audio requires: <seconds>"
        usage >&2
        exit "$STONX_USAGE"
      fi
      valid_duration "$1" || die "audio duration must be an integer 1..3600" "$STONX_USAGE"
      cmd_audio "$1"
      ;;
    list)
      cmd_list "$@"
      ;;
    pull)
      cmd_pull "$@"
      ;;
    clean)
      require_no_args "$@"
      not_enabled "clean"
      ;;
    *)
      err "unknown command: ${cmd:-<empty>}"
      usage >&2
      exit "$STONX_USAGE"
      ;;
  esac
}

main "$@"

