<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Least-privilege manifest surface. Runtime requests will stay narrower than this list. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Needed only to make the short-lived foreground-service notification visible on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Short-lived foreground service only while recording; no permanent service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- No MAIN/LAUNCHER activity: the helper APK must not appear as an independent launcher icon. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true">
    </application>
</manifest>
